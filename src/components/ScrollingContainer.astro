---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  :root{
    scroll-snap-type: x mandatory;
    --card-padding:;
    --content-width: ;
    --card-gap:;
    --card-border-radius:;
    --card-background:;
    --card-text-color:;
  }
  ul {
    border: solid red;
    list-style: none;
    display: flex;
    overflow-x: auto;
    padding-inline: max(1rem, 50% - var(--content-width) / 2);
    /* scroll-snap-align: center;
    scroll-snap-stop: always; */
    > * {
    flex: 1 0 45%;
  }
}

li{
  
border: solid orange;
}
  
/*
brug på en ul listen til cards (tilføj subgrid på Li)

display: grid;
place-content: center;

*/

</style>
