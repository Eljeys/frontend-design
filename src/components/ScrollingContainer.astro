---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
 
  :root{
    --card-padding:3rem;
    --content-width:75rem;
    --card-gap:.5rem;
    --card-border-radius:1rem;
    --card-background: rgb(225, 222, 222);
    --card-text-color:black;
  }
  ul {
    margin-block-start: 2rem;
    list-style: none;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap:var(--card-gap);
    scroll-snap-stop: always;
    > * {
    flex: 1 0 45%;
  }
}
.full-width{
  padding-inline: max(1rem, 50% - var(--content-width) / 2);
}

li{
  scroll-snap-align: center;
  background-color: var(--card-background);
  gap: var(--card-gap);
  border-radius: var(--card-border-radius);
  padding: var(--card-padding);
}
  
/*
brug på en ul listen til cards (tilføj subgrid på Li)

display: grid;
place-content: center;

*/

</style>
