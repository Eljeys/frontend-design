---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    border: solid red;
    list-style: none;
    display: flex;
    overflow-x: auto;
    > * {
    flex: 1 0 70%;
  }
  scroll-snap-align: center;
  scroll-snap-stop: always;
}
  
  html {
  scroll-snap-type: x mandatory;
}
</style>
