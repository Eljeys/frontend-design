---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
 
  :root{
    --card-padding:3rem;
    --content-width:75rem;
    --card-gap:1rem;
    --card-border-radius:1rem;
    --card-background: rgb(225, 222, 222);
    --card-text-color:black;
  }
  ul {
    
    grid-column: 1 / -1;
    scroll-snap-type: x mandatory;
    display: flex;
    gap:var(--card-gap);
    overflow-x: auto;
    list-style: none;
    margin-block-start: 2rem;
    scroll-snap-stop: always;
    scroll-padding-inline-start: max(1rem, 50% - var(--content-width) / 2) ;
    > * {
      flex: 1 0 45%;
    }
  }
  .full-width{
    padding-inline: max(1rem, 50% - var(--content-width) / 2);
  }

li{
  flex-basis: min(95%, 400px);
  flex-shrink: 0;
  
 
  scroll-snap-align: start;
  background-color: var(--card-background);
  gap: var(--card-gap);
  border-radius: var(--card-border-radius);
  padding: var(--card-padding);
}
  
/*
brug på en ul listen til cards (tilføj subgrid på Li)

display: grid;
place-content: center;

*/

</style>
